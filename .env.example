NODE_ENV=development
PORT=5001
DATABASE_URL=postgres://your-user@localhost:5432/psychoportal
SESSION_SECRET=replace-me
JWT_SECRET=replace-me
PAYLOAD_SECRET=replace-me
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:23740
LOG_LEVEL=info

# Optional integrations. Leave empty for local fresh-start development.
MIDTRANS_PRODUCTION_SERVER_KEY=
MIDTRANS_PRODUCTION_CLIENT_KEY=
MIDTRANS_PRODUCTION_MERCHANT_ID=
VITE_MIDTRANS_PRODUCTION_CLIENT_KEY=
VITE_API_BASE_URL=
VITE_CMS_BASE_URL=
VITE_MAIN_SITE_URL=
VITE_ASESMEN_PLATFORM_URL=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEFAULT_OBJECT_STORAGE_BUCKET_ID=

# Optional Instagram Login integration (server only; never VITE_ secrets).
# Leave blank until a Business/Creator account and Meta app are selected.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=
INSTAGRAM_REDIRECT_URI=https://asesmen.pi-psychology.com/api/admin/instagram/callback
INSTAGRAM_ADMIN_URL=https://asesmen.pi-psychology.com/admin/articles
INSTAGRAM_PUBLIC_URL=https://asesmen.pi-psychology.com
# 32 random bytes encoded as 64 hexadecimal characters. Keep stable/backed up.
INSTAGRAM_TOKEN_KEY=
